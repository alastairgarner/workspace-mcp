{
  "name": "workspace-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev:http": "tsx src/http-main.ts",
    "auth:google": "tsx src/login.ts",
    "auth:hash": "tsx src/token-hash.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/http-main.js",
    "test": "pnpm build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@googleapis/gmail": "22.1.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
